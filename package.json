{
  "name": "acemate",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode web",
    "dev:server": "node --watch --env-file-if-exists=.env server/index.mjs",
    "build": "vite build --mode web",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "build:artifact": "vite build --mode artifact && node assemble.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@hono/node-server": "^1.19.17",
    "hono": "^4.13.9"
  },
  "devDependencies": {
    "@paper-design/shaders-react": "^0.0.81",
    "@tailwindcss/vite": "4.2.4",
    "@tanstack/react-router": "1.170.16",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "clsx": "^2.1.1",
    "lucide-react": "0.575.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-markdown": "10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "4.2.4",
    "thinking-orbs": "0.3.1",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.0.16"
  },
  "version": "1.0.0",
  "description": "AceMate: an AI study and chat assistant powered by Claude. Runs as a standalone website or as a claude.ai page.",
  "engines": {
    "node": ">=22.13"
  }
}
