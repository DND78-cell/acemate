# Copy to .env and fill in. `npm start` reads it automatically.

# Required: your Anthropic API key (https://console.anthropic.com). Every
# answer AceMate gives is billed to this key.
ANTHROPIC_API_KEY=

# Models. Ace Ultra uses ACEMATE_MODEL; Ace One uses ACEMATE_FAST_MODEL
# (defaults to the same model at a lower effort). For a faster, cheaper
# Ace One, set ACEMATE_FAST_MODEL=claude-haiku-4-5.
ACEMATE_MODEL=claude-opus-5
# ACEMATE_FAST_MODEL=claude-haiku-4-5

# When Claude's safety checks decline a request, re-run it on Anthropic's
# recommended fallback model. Set to "off" to disable.
ACEMATE_FALLBACKS=on

# Web server
PORT=8787

# Database. With DATABASE_URL set (a Postgres address, e.g. from Neon), AceMate
# uses Postgres; Vercel sets this when you connect a Neon database. Without it,
# AceMate keeps everything in one SQLite file at ACEMATE_DB_PATH; put that on
# persistent storage in production.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
ACEMATE_DB_PATH=data/acemate.db

# Usage limits per hour (they protect your API bill).
ACEMATE_AI_LIMIT_PER_HOUR=60
ACEMATE_GUEST_AI_LIMIT_PER_HOUR=10
# Require an account before anyone can chat.
ACEMATE_REQUIRE_SIGNIN=false

# Behind a reverse proxy / load balancer (Render, Railway, Fly, nginx…):
# trust X-Forwarded-For so limits apply per visitor, not per proxy.
# (On Vercel this is on automatically.)
ACEMATE_TRUST_PROXY=false
